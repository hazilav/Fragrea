# ==============================================================================
# FRAGREA PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Persistent MySQL Database Connection
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict
# For PlanetScale: mysql://USER:PASSWORD@HOST/DATABASE?ssl={"rejectUnauthorized":true}
DATABASE_URL="mysql://root:password@localhost:3306/fragrea?sslaccept=strict"

# Cryptographic Session Secret for Admin Authentication
# Generate a 32+ character random secret
ADMIN_SESSION_SECRET="fragrea_luxury_maison_vault_secret_2026_production_key"

# Base URL for public links and callbacks
NEXT_PUBLIC_APP_URL="https://fragrea.vercel.app"

# Payment Gateways (Optional / Sandbox enabled by default)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cloud Storage (Optional / Local storage enabled by default)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
